<!doctype html>
<html>
<head>
  <meta http-equiv="x-ua-compatible" content="IE=11">
  <title>Tender Control Installer</title>
  <hta:application
    id="OpportunityOSInstaller"
    applicationname="Tender Control Installer"
    border="thin"
    borderstyle="normal"
    caption="yes"
    contextmenu="no"
    icon="%SystemRoot%\System32\shell32.dll"
    maximizebutton="no"
    minimizebutton="yes"
    scroll="no"
    showintaskbar="yes"
    singleinstance="yes"
    sysmenu="yes"
    windowstate="normal" />
  <style>
    html, body {
      width: 100%;
      height: 100%;
      margin: 0;
      overflow: hidden;
      font-family: "Segoe UI", Arial, sans-serif;
      color: #1f2933;
      background: #f3f3f3;
    }

    .shell {
      width: 720px;
      height: 520px;
      background: #ffffff;
      border: 1px solid #c8c8c8;
      box-sizing: border-box;
    }

    .header {
      height: 96px;
      padding: 20px 28px;
      box-sizing: border-box;
      border-bottom: 1px solid #dedede;
      background: linear-gradient(#ffffff, #f7f7f7);
    }

    .title {
      margin: 0 0 6px;
      font-size: 24px;
      font-weight: 600;
    }

    .subtitle {
      margin: 0;
      color: #5f6b7a;
      font-size: 13px;
    }

    .content {
      padding: 24px 28px 18px;
      height: 330px;
      box-sizing: border-box;
    }

    .status-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 10px;
    }

    .status {
      font-size: 15px;
      font-weight: 600;
    }

    .remaining {
      color: #5f6b7a;
      font-size: 12px;
    }

    .progress {
      height: 18px;
      border: 1px solid #b8b8b8;
      background: #eeeeee;
      box-shadow: inset 0 1px 1px rgba(0,0,0,.08);
      margin-bottom: 18px;
    }

    .bar {
      height: 100%;
      width: 0%;
      background: #0078d4;
      transition: width .2s ease;
    }

    .steps {
      margin-bottom: 18px;
      font-size: 13px;
    }

    .step {
      display: inline-block;
      width: 48%;
      margin: 0 1% 8px 0;
      color: #5f6b7a;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .step.done {
      color: #107c10;
      font-weight: 600;
    }

    .step.active {
      color: #005a9e;
      font-weight: 600;
    }

    .log {
      width: 100%;
      height: 132px;
      box-sizing: border-box;
      resize: none;
      border: 1px solid #c8c8c8;
      background: #fbfbfb;
      color: #2c333a;
      font-family: Consolas, "Courier New", monospace;
      font-size: 12px;
      padding: 8px;
    }

    .footer {
      height: 94px;
      padding: 18px 28px;
      border-top: 1px solid #dedede;
      box-sizing: border-box;
      background: #f7f7f7;
      text-align: right;
    }

    button {
      min-width: 104px;
      height: 32px;
      margin-left: 8px;
      border: 1px solid #adadad;
      background: #ffffff;
      font-family: "Segoe UI", Arial, sans-serif;
      font-size: 13px;
      cursor: pointer;
    }

    button.primary {
      border-color: #005a9e;
      background: #0078d4;
      color: #ffffff;
    }

    button:disabled {
      color: #999999;
      background: #eeeeee;
      border-color: #d5d5d5;
      cursor: default;
    }
  </style>
</head>
<body>
  <div class="shell">
    <div class="header">
      <h1 class="title">Tender Control Setup</h1>
      <p class="subtitle">Installing an official offline package or repairing a copied source folder.</p>
    </div>

    <div class="content">
      <div class="status-row">
        <div id="status" class="status">Ready to install</div>
        <div id="remaining" class="remaining">5 steps remaining</div>
      </div>
      <div class="progress"><div id="bar" class="bar"></div></div>

      <div class="steps">
        <div id="step1" class="step">1. Detect installation type</div>
        <div id="step2" class="step">2. Prepare application files</div>
        <div id="step3" class="step">3. Verify local application</div>
        <div id="step4" class="step">4. Create shortcuts</div>
        <div id="step5" class="step">5. Finish setup</div>
      </div>

      <textarea id="log" class="log" readonly></textarea>
    </div>

    <div class="footer">
      <button id="installBtn" class="primary" onclick="startInstall()">Install</button>
      <button id="openBtn" class="primary" onclick="openApp()" disabled>Open app</button>
      <button id="closeBtn" onclick="window.close()" disabled>Close</button>
    </div>
  </div>

  <script language="javascript">
    var shell = new ActiveXObject("WScript.Shell");
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var scriptDir = getScriptDir();
    var currentExec = null;
    var pollTimer = null;
    var stepIndex = 0;
    var launchAttempt = 0;
    var installKind = "offline";

    window.onerror = function (message, url, line) {
      var detail = "Setup encountered an unexpected error. Please keep this window open and report: " + message + " (line " + line + ")";
      try { logLine("[ERROR] " + detail); } catch (ignore) {}
      alert(detail);
      return true;
    };

    window.resizeTo(740, 560);
    window.moveTo((screen.width - 740) / 2, (screen.height - 560) / 2);

    function getScriptDir() {
      var configuredRoot = shell.Environment("PROCESS")("OPPORTUNITYOS_ROOT");
      if (configuredRoot && fso.FolderExists(configuredRoot)) return configuredRoot;
      var path = decodeURIComponent(location.pathname);
      path = path.replace(/^\//, "").replace(/\//g, "\\");
      return fso.GetParentFolderName(path);
    }

    function el(id) {
      return document.getElementById(id);
    }

    function logLine(text) {
      el("log").value += text + "\r\n";
      el("log").scrollTop = el("log").scrollHeight;
    }

    function setStep(index, text) {
      stepIndex = index;
      el("status").innerText = text;
      el("remaining").innerText = Math.max(5 - index, 0) + " steps remaining";
      el("bar").style.width = (index * 20) + "%";
      for (var i = 1; i <= 5; i++) {
        el("step" + i).className = "step" + (i < index ? " done" : (i === index ? " active" : ""));
      }
    }

    function failInstall(message) {
      if (pollTimer) window.clearInterval(pollTimer);
      el("status").innerText = "Setup failed";
      el("remaining").innerText = "Review the message below";
      logLine("[ERROR] " + message);
      el("installBtn").disabled = false;
      el("closeBtn").disabled = false;
    }

    function runCommand(command, onDone) {
      logLine("> " + command);
      var tempDir = fso.GetSpecialFolder(2);
      var tempName = fso.GetTempName();
      var logFile = tempDir + "\\" + tempName + ".log";
      var doneFile = tempDir + "\\" + tempName + ".done";
      var runnerFile = tempDir + "\\OpportunityOS-install-" + tempName + ".cmd";

      // Run short, local verification commands without opening a terminal.
      // Installation never invokes npm, downloads packages or compiles code.
      var runner = fso.CreateTextFile(runnerFile, true);
      runner.WriteLine("@echo off");
      runner.WriteLine("(");
      runner.WriteLine(command);
      runner.WriteLine(") > \"" + logFile + "\" 2>&1");
      runner.WriteLine("> \"" + doneFile + "\" echo %errorlevel%");
      runner.Close();
      try {
        shell.Run("cmd.exe /d /c \"\"" + runnerFile + "\"\"", 0, false);
      } catch (err) {
        failInstall("Could not start a setup step: " + err.message);
        return;
      }

      var lastPos = 0;
      var startedAt = new Date().getTime();
      pollTimer = window.setInterval(function () {
        if (fso.FileExists(logFile)) {
          try {
            var progressFile = fso.OpenTextFile(logFile, 1, false, -2);
            var progress = progressFile.ReadAll();
            progressFile.Close();
            if (progress.length > lastPos) {
              var newLines = progress.substring(lastPos).split(/\r?\n/);
              for (var j = 0; j < newLines.length - 1; j++) if (newLines[j]) logLine(newLines[j]);
              lastPos = progress.length - newLines[newLines.length - 1].length;
            }
          } catch (e) {}
        }

        var elapsedSeconds = Math.floor((new Date().getTime() - startedAt) / 1000);
        if (elapsedSeconds > 0 && elapsedSeconds % 5 === 0) {
          el("remaining").innerText = "Still working (" + elapsedSeconds + " seconds)";
        }

        if (elapsedSeconds >= 900) {
          window.clearInterval(pollTimer);
          failInstall("Local package verification did not finish within 15 minutes. Close the installer, confirm that antivirus is not holding the extracted folder, and try again.");
          return;
        }

        if (fso.FileExists(doneFile)) {
          window.clearInterval(pollTimer);
          var exitCode = 1;
          try {
            var done = fso.OpenTextFile(doneFile, 1);
            exitCode = parseInt(done.ReadLine(), 10);
            done.Close();
          } catch (e) {}
          if (fso.FileExists(logFile)) {
            try {
              var file = fso.OpenTextFile(logFile, 1, false, -2);
              var content = file.ReadAll();
              file.Close();
              var lines = content.split(/\r?\n/);
              for (var i = 0; i < lines.length; i++) if (lines[i]) logLine(lines[i]);
            } catch (e) {}
          }

          try { fso.DeleteFile(logFile, true); } catch (e) {}
          try { fso.DeleteFile(doneFile, true); } catch (e) {}
          try { fso.DeleteFile(runnerFile, true); } catch (e) {}

          onDone(exitCode);
        }
      }, 250);
    }

    function startInstall() {
      el("installBtn").disabled = true;
      el("openBtn").disabled = true;
      el("closeBtn").disabled = true;
      el("log").value = "";

      if (!fso.FileExists(scriptDir + "\\offline-runtime.json")) {
        startSourceInstall();
        return;
      }

      installKind = "offline";
      el("step1").innerText = "1. Verify offline runtime";
      el("step2").innerText = "2. Check packaged files";
      el("step3").innerText = "3. Confirm local-only services";
      setStep(1, "Verifying offline runtime");
      var verifier = scriptDir + "\\scripts\\verify-offline-runtime.ps1";
      if (!fso.FileExists(verifier)) {
        failInstall("The offline package verifier is missing. Extract the complete official release ZIP and try again.");
        return;
      }
      runCommand("powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"" + verifier + "\" -ProjectRoot \"" + scriptDir + "\"", function (code) {
        if (code !== 0) {
          failInstall("The offline package failed its integrity or local-network safety check. No files were downloaded. Extract a fresh official release ZIP and try again.");
          return;
        }
        verifyOpportunityOS();
      });
    }

    function startSourceInstall() {
      installKind = "source";
      el("step1").innerText = "1. Check Node.js and npm";
      el("step2").innerText = "2. Install or repair dependencies";
      el("step3").innerText = "3. Build Tender Control";
      var sourceInstaller = scriptDir + "\\scripts\\install-source-mode.ps1";
      if (!fso.FileExists(sourceInstaller) || !fso.FileExists(scriptDir + "\\package.json") || !fso.FileExists(scriptDir + "\\package-lock.json")) {
        failInstall("This source copy is incomplete. Copy the complete project again or use the official release ZIP.");
        return;
      }

      logLine("[INFO] Source-copy mode detected. This mode uses Node.js/npm from this PC and may require Internet access.");
      setStep(1, "Checking Node.js and npm");
      runSourcePhase(sourceInstaller, "Validate", function (code) {
        if (code !== 0) {
          failInstall("Node.js and npm were not found or could not start. Install Node.js LTS for this user, then retry; alternatively use the official offline release ZIP.");
          return;
        }
        setStep(2, "Installing or repairing dependencies");
        runSourcePhase(sourceInstaller, "Dependencies", function (dependencyCode) {
          if (dependencyCode !== 0) {
            failInstall("Dependencies could not be installed. Check the installer log, network/proxy access and antivirus locks, then retry in the same folder.");
            return;
          }
          setStep(3, "Building Tender Control");
          runSourcePhase(sourceInstaller, "Build", function (buildCode) {
            if (buildCode !== 0 || !fso.FileExists(scriptDir + "\\node_modules\\vite\\bin\\vite.js") || !fso.FileExists(scriptDir + "\\node_modules\\tsx\\dist\\cli.mjs") || !fso.FileExists(scriptDir + "\\dist\\index.html")) {
              failInstall("Tender Control could not be built from this source copy. Review the log and retry; existing user data was not changed.");
              return;
            }
            logLine("[OK] Source dependencies and production build are ready.");
            logLine("[OK] Frontend and backend remain restricted to 127.0.0.1.");
            finishOpportunityOSSetup();
          });
        });
      });
    }

    function runSourcePhase(sourceInstaller, phase, onDone) {
      runCommand("powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"" + sourceInstaller + "\" -ProjectRoot \"" + scriptDir + "\" -Phase " + phase, onDone);
    }

    function verifyOpportunityOS() {
      setStep(2, "Checking packaged files");
      if (!fso.FileExists(scriptDir + "\\engine_opportunityos.bat")) {
        failInstall("engine_opportunityos.bat was not found in the installer folder.");
        return;
      }
      if (!fso.FileExists(scriptDir + "\\runtime\\node.exe") || !fso.FileExists(scriptDir + "\\node_modules\\vite\\bin\\vite.js") || !fso.FileExists(scriptDir + "\\dist\\index.html")) {
        failInstall("The extracted offline application files are incomplete.");
        return;
      }
      logLine("[OK] Runtime, dependencies and the production build are already packaged. No npm or internet access is needed.");
      setStep(3, "Confirming local-only services");
      logLine("[OK] Frontend and backend are restricted to 127.0.0.1 and are not exposed to the office LAN.");
      finishOpportunityOSSetup();
    }

    function finishOpportunityOSSetup() {
      logLine("[OK] Stable Tender Control files verified.");
      if (!fso.FileExists(scriptDir + "\\OpportunityOS.exe")) {
        logLine("[INFO] The optional legacy executable is not required. Shortcuts use the stable Tender Control launcher.");
      }

      setStep(4, "Creating shortcuts");
      if (!fso.FileExists(scriptDir + "\\OPEN_OPPORTUNITYOS.vbs")) {
        failInstall("OPEN_OPPORTUNITYOS.vbs was not found after setup.");
        return;
      }
      createShortcuts();

      // Record the verified mode. Re-running setup overwrites stale markers from
      // older installers, so a copied source folder can repair itself in place.
      var marker = fso.CreateTextFile(scriptDir + "\\.opportunityos-setup-complete", true);
      marker.WriteLine("Tender Control setup completed successfully.");
      marker.WriteLine("offline=" + (installKind === "offline" ? "true" : "false"));
      marker.WriteLine("source=" + (installKind === "source" ? "true" : "false"));
      marker.Close();

      setStep(5, "Setup complete");
      el("remaining").innerText = "0 steps remaining";
      el("bar").style.width = "100%";
      logLine("[OK] Setup complete. Choose Open app or Close.");
      el("openBtn").disabled = false;
      el("closeBtn").disabled = false;
    }

    function createShortcuts() {
      try {
        var desktopDir = shell.SpecialFolders("Desktop");
        var startMenuDir = shell.SpecialFolders("Programs") + "\\Tender Control";
        if (!fso.FolderExists(startMenuDir)) fso.CreateFolder(startMenuDir);

        var iconPath = scriptDir + "\\opportunityos.ico";
        var openTarget = scriptDir + "\\OPEN_OPPORTUNITYOS.vbs";
        var uninstallTarget = scriptDir + "\\DESINSTALAR_OPPORTUNITYOS.vbs";

        // CreateShortcut + Save() always overwrites any shortcut with the
        // same name, so re-running the installer after this folder moves or
        // is reprovisioned self-heals the shortcut's target path instead of
        // leaving a stale one — shortcuts were previously removed entirely
        // to sidestep that exact failure mode on corporate machines.
        var appShortcut = shell.CreateShortcut(desktopDir + "\\Tender Control.lnk");
        appShortcut.TargetPath = "wscript.exe";
        appShortcut.Arguments = "\"" + openTarget + "\"";
        appShortcut.WorkingDirectory = scriptDir;
        appShortcut.WindowStyle = 7;
        appShortcut.IconLocation = iconPath + ",0";
        appShortcut.Description = "Open Tender Control";
        appShortcut.Save();

        var startShortcut = shell.CreateShortcut(startMenuDir + "\\Tender Control.lnk");
        startShortcut.TargetPath = "wscript.exe";
        startShortcut.Arguments = "\"" + openTarget + "\"";
        startShortcut.WorkingDirectory = scriptDir;
        startShortcut.WindowStyle = 7;
        startShortcut.IconLocation = iconPath + ",0";
        startShortcut.Description = "Open Tender Control";
        // Windows only honors a shortcut's hotkey while it lives on the
        // Desktop or in the Start Menu; keep it on exactly one shortcut so
        // there's no ambiguity about which target Ctrl+Alt+O launches.
        startShortcut.Hotkey = "CTRL+ALT+O";
        startShortcut.Save();

        var uninstallShortcut = shell.CreateShortcut(startMenuDir + "\\Uninstall Tender Control.lnk");
        uninstallShortcut.TargetPath = "wscript.exe";
        uninstallShortcut.Arguments = "\"" + uninstallTarget + "\"";
        uninstallShortcut.WorkingDirectory = scriptDir;
        uninstallShortcut.WindowStyle = 1;
        uninstallShortcut.IconLocation = "%SystemRoot%\\System32\\shell32.dll,-131";
        uninstallShortcut.Description = "Uninstall Tender Control";
        uninstallShortcut.Save();

        logLine("[OK] Desktop and Start Menu shortcuts created. Ctrl+Alt+O opens Tender Control from anywhere.");
        logLine("[INFO] Pin the Desktop or Start Menu shortcut to your taskbar for a stable icon — pinning the app's live window instead can lose its icon after a restart.");
      } catch (err) {
        logLine("[WARN] Could not create shortcuts: " + err.message + ". Tender Control still works via OPEN_OPPORTUNITYOS.vbs in this folder.");
      }
    }

    function openApp() {
      var launcher = scriptDir + "\\OPEN_OPPORTUNITYOS.vbs";
      var closer = scriptDir + "\\CLOSE_OPPORTUNITYOS.bat";
      if (!fso.FileExists(launcher)) {
        failInstall("OPEN_OPPORTUNITYOS.vbs was not found after setup.");
        return;
      }
      if (!fso.FileExists(closer)) {
        failInstall("CLOSE_OPPORTUNITYOS.bat was not found after setup.");
        return;
      }
      el("openBtn").disabled = true;
      el("closeBtn").disabled = true;
      setStep(5, "Closing previous Tender Control version");
      el("remaining").innerText = "Freeing local Tender Control ports";
      logLine("[INFO] Closing any previous Tender Control engine on ports 3000 and 3099. No terminal window is needed.");
      runCommand("call \"" + closer + "\" SILENT", function (closeCode) {
        if (closeCode !== 0) {
          failInstall("The previous Tender Control engine could not be stopped. See the log above and retry.");
          return;
        }
        setStep(5, "Starting Tender Control");
        el("remaining").innerText = "Checking the local application";
        logLine("[INFO] Starting the new Tender Control version in the background.");
        shell.Run("wscript.exe \"" + launcher + "\"", 1, false);
        launchAttempt = 0;
        window.setTimeout(checkAppStarted, 1000);
      });
    }

    function checkAppStarted() {
      var started = false;
      try {
        var request = new ActiveXObject("MSXML2.XMLHTTP");
        request.open("GET", "http://127.0.0.1:3000", false);
        request.send();
        started = request.status >= 200 && request.status < 500;
      } catch (ignore) {}

      if (started) {
        el("status").innerText = "Tender Control started successfully";
        el("remaining").innerText = "You may close this setup window";
        el("bar").style.width = "100%";
        logLine("[OK] Tender Control is running. The application window should now be open.");
        alert("Tender Control started successfully. You can now close this setup window.");
        el("closeBtn").disabled = false;
        return;
      }

      launchAttempt++;
      if (launchAttempt >= 30) {
        failInstall("Tender Control did not start within 30 seconds. No terminal is required: use the log above to identify the failed step, then choose Install to retry.");
        return;
      }

      el("remaining").innerText = "Waiting for Tender Control to start (" + launchAttempt + "/30)";
      window.setTimeout(checkAppStarted, 1000);
    }
  </script>
</body>
</html>
