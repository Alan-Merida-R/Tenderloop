<!doctype html>
<html>
<head>
  <meta http-equiv="x-ua-compatible" content="IE=11">
  <title>OpportunityOS Installer</title>
  <hta:application
    id="OpportunityOSInstaller"
    applicationname="OpportunityOS Installer"
    border="thin"
    borderstyle="normal"
    caption="yes"
    contextmenu="no"
    icon="%SystemRoot%\System32\shell32.dll"
    maximizebutton="no"
    minimizebutton="yes"
    scroll="no"
    showintaskbar="yes"
    singleinstance="yes"
    sysmenu="yes"
    windowstate="normal" />
  <style>
    html, body {
      width: 100%;
      height: 100%;
      margin: 0;
      overflow: hidden;
      font-family: "Segoe UI", Arial, sans-serif;
      color: #1f2933;
      background: #f3f3f3;
    }

    .shell {
      width: 720px;
      height: 520px;
      background: #ffffff;
      border: 1px solid #c8c8c8;
      box-sizing: border-box;
    }

    .header {
      height: 96px;
      padding: 20px 28px;
      box-sizing: border-box;
      border-bottom: 1px solid #dedede;
      background: linear-gradient(#ffffff, #f7f7f7);
    }

    .title {
      margin: 0 0 6px;
      font-size: 24px;
      font-weight: 600;
    }

    .subtitle {
      margin: 0;
      color: #5f6b7a;
      font-size: 13px;
    }

    .content {
      padding: 24px 28px 18px;
      height: 330px;
      box-sizing: border-box;
    }

    .status-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 10px;
    }

    .status {
      font-size: 15px;
      font-weight: 600;
    }

    .remaining {
      color: #5f6b7a;
      font-size: 12px;
    }

    .progress {
      height: 18px;
      border: 1px solid #b8b8b8;
      background: #eeeeee;
      box-shadow: inset 0 1px 1px rgba(0,0,0,.08);
      margin-bottom: 18px;
    }

    .bar {
      height: 100%;
      width: 0%;
      background: #0078d4;
      transition: width .2s ease;
    }

    .steps {
      margin-bottom: 18px;
      font-size: 13px;
    }

    .step {
      display: inline-block;
      width: 48%;
      margin: 0 1% 8px 0;
      color: #5f6b7a;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .step.done {
      color: #107c10;
      font-weight: 600;
    }

    .step.active {
      color: #005a9e;
      font-weight: 600;
    }

    .log {
      width: 100%;
      height: 132px;
      box-sizing: border-box;
      resize: none;
      border: 1px solid #c8c8c8;
      background: #fbfbfb;
      color: #2c333a;
      font-family: Consolas, "Courier New", monospace;
      font-size: 12px;
      padding: 8px;
    }

    .footer {
      height: 94px;
      padding: 18px 28px;
      border-top: 1px solid #dedede;
      box-sizing: border-box;
      background: #f7f7f7;
      text-align: right;
    }

    button {
      min-width: 104px;
      height: 32px;
      margin-left: 8px;
      border: 1px solid #adadad;
      background: #ffffff;
      font-family: "Segoe UI", Arial, sans-serif;
      font-size: 13px;
      cursor: pointer;
    }

    button.primary {
      border-color: #005a9e;
      background: #0078d4;
      color: #ffffff;
    }

    button:disabled {
      color: #999999;
      background: #eeeeee;
      border-color: #d5d5d5;
      cursor: default;
    }
  </style>
</head>
<body>
  <div class="shell">
    <div class="header">
      <h1 class="title">OpportunityOS Setup</h1>
      <p class="subtitle">Installing the local Windows app shortcuts and dependencies.</p>
    </div>

    <div class="content">
      <div class="status-row">
        <div id="status" class="status">Ready to install</div>
        <div id="remaining" class="remaining">5 steps remaining</div>
      </div>
      <div class="progress"><div id="bar" class="bar"></div></div>

      <div class="steps">
        <div id="step1" class="step">1. Check Node.js</div>
        <div id="step2" class="step">2. Install dependencies</div>
        <div id="step3" class="step">3. Verify OpportunityOS</div>
        <div id="step4" class="step">4. Create shortcuts</div>
        <div id="step5" class="step">5. Finish setup</div>
      </div>

      <textarea id="log" class="log" readonly></textarea>
    </div>

    <div class="footer">
      <button id="installBtn" class="primary" onclick="startInstall()">Install</button>
      <button id="openBtn" class="primary" onclick="openApp()" disabled>Open app</button>
      <button id="closeBtn" onclick="window.close()" disabled>Close</button>
    </div>
  </div>

  <script language="javascript">
    var shell = new ActiveXObject("WScript.Shell");
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var scriptDir = getScriptDir();
    var currentExec = null;
    var pollTimer = null;
    var stepIndex = 0;
    var launchAttempt = 0;

    window.onerror = function (message, url, line) {
      var detail = "Setup encountered an unexpected error. Please keep this window open and report: " + message + " (line " + line + ")";
      try { logLine("[ERROR] " + detail); } catch (ignore) {}
      alert(detail);
      return true;
    };

    window.resizeTo(740, 560);
    window.moveTo((screen.width - 740) / 2, (screen.height - 560) / 2);

    function getScriptDir() {
      var configuredRoot = shell.Environment("PROCESS")("OPPORTUNITYOS_ROOT");
      if (configuredRoot && fso.FolderExists(configuredRoot)) return configuredRoot;
      var path = decodeURIComponent(location.pathname);
      path = path.replace(/^\//, "").replace(/\//g, "\\");
      return fso.GetParentFolderName(path);
    }

    function el(id) {
      return document.getElementById(id);
    }

    function logLine(text) {
      el("log").value += text + "\r\n";
      el("log").scrollTop = el("log").scrollHeight;
    }

    function setStep(index, text) {
      stepIndex = index;
      el("status").innerText = text;
      el("remaining").innerText = Math.max(5 - index, 0) + " steps remaining";
      el("bar").style.width = (index * 20) + "%";
      for (var i = 1; i <= 5; i++) {
        el("step" + i).className = "step" + (i < index ? " done" : (i === index ? " active" : ""));
      }
    }

    function failInstall(message) {
      if (pollTimer) window.clearInterval(pollTimer);
      el("status").innerText = "Setup failed";
      el("remaining").innerText = "Review the message below";
      logLine("[ERROR] " + message);
      el("installBtn").disabled = false;
      el("closeBtn").disabled = false;
    }

    function runCommand(command, onDone) {
      logLine("> " + command);
      var tempDir = fso.GetSpecialFolder(2);
      var tempName = fso.GetTempName();
      var logFile = tempDir + "\\" + tempName + ".log";
      var doneFile = tempDir + "\\" + tempName + ".done";
      var runnerFile = tempDir + "\\OpportunityOS-install-" + tempName + ".cmd";

      // Run commands hidden so npm never opens a distracting terminal window.
      // The temporary runner writes its own exit code; the HTA remains visible
      // and keeps reporting progress while the background work continues.
      var runner = fso.CreateTextFile(runnerFile, true);
      runner.WriteLine("@echo off");
      runner.WriteLine("(");
      runner.WriteLine(command);
      runner.WriteLine(") > \"" + logFile + "\" 2>&1");
      runner.WriteLine("> \"" + doneFile + "\" echo %errorlevel%");
      runner.Close();
      try {
        shell.Run("cmd.exe /d /c \"\"" + runnerFile + "\"\"", 0, false);
      } catch (err) {
        failInstall("Could not start a setup step: " + err.message);
        return;
      }

      var lastPos = 0;
      var startedAt = new Date().getTime();
      pollTimer = window.setInterval(function () {
        if (fso.FileExists(logFile)) {
          try {
            var progressFile = fso.OpenTextFile(logFile, 1, false, -2);
            var progress = progressFile.ReadAll();
            progressFile.Close();
            if (progress.length > lastPos) {
              var newLines = progress.substring(lastPos).split(/\r?\n/);
              for (var j = 0; j < newLines.length - 1; j++) if (newLines[j]) logLine(newLines[j]);
              lastPos = progress.length - newLines[newLines.length - 1].length;
            }
          } catch (e) {}
        }

        var elapsedSeconds = Math.floor((new Date().getTime() - startedAt) / 1000);
        if (elapsedSeconds > 0 && elapsedSeconds % 5 === 0) {
          el("remaining").innerText = "Still working (" + elapsedSeconds + " seconds)";
        }

        if (elapsedSeconds >= 900) {
          window.clearInterval(pollTimer);
          failInstall("This setup step did not finish within 15 minutes. The log above shows the last response; check for a corporate proxy, antivirus lock, or blocked npm access.");
          return;
        }

        if (fso.FileExists(doneFile)) {
          window.clearInterval(pollTimer);
          var exitCode = 1;
          try {
            var done = fso.OpenTextFile(doneFile, 1);
            exitCode = parseInt(done.ReadLine(), 10);
            done.Close();
          } catch (e) {}
          if (fso.FileExists(logFile)) {
            try {
              var file = fso.OpenTextFile(logFile, 1, false, -2);
              var content = file.ReadAll();
              file.Close();
              var lines = content.split(/\r?\n/);
              for (var i = 0; i < lines.length; i++) if (lines[i]) logLine(lines[i]);
            } catch (e) {}
          }

          try { fso.DeleteFile(logFile, true); } catch (e) {}
          try { fso.DeleteFile(doneFile, true); } catch (e) {}
          try { fso.DeleteFile(runnerFile, true); } catch (e) {}

          onDone(exitCode);
        }
      }, 250);
    }

    function startInstall() {
      el("installBtn").disabled = true;
      el("openBtn").disabled = true;
      el("closeBtn").disabled = true;
      el("log").value = "";

      setStep(1, "Checking Node.js");
      runCommand("where node", function (code) {
        if (code !== 0) {
          failInstall("Node.js was not found. Install it from https://nodejs.org/ and run this installer again.");
          return;
        }

        setStep(2, "Preparing local OpportunityOS services");
        var closer = scriptDir + "\\CLOSE_OPPORTUNITYOS.bat";
        if (!fso.FileExists(closer)) {
          failInstall("CLOSE_OPPORTUNITYOS.bat was not found in the installer folder.");
          return;
        }
        runCommand("call \"" + closer + "\" SILENT", function (closeCode) {
          if (closeCode !== 0) {
            failInstall("A previous OpportunityOS process is still using a local port. Close that OpportunityOS window and choose Install to retry.");
            return;
          }
          setStep(2, "Installing dependencies");
          if (fso.FileExists(scriptDir + "\\node_modules\\.bin\\vite.cmd")) {
            logLine("[OK] Dependencies are already installed.");
            verifyOpportunityOS();
          } else {
            logLine("[INFO] Installing or repairing dependencies. This can take several minutes and needs normal internet access to npm.");
            // `npm install` repairs a partial dependency folder in place. Unlike
            // npm ci it does not first delete every native binary, which avoids
            // common EPERM failures from corporate antivirus scanners. The
            // committed lockfile still pins the reviewed dependency versions.
            runCommand("cd /d \"" + scriptDir + "\" && npm.cmd install --include=dev --no-audit --no-fund", function (npmCode) {
              if (npmCode !== 0) {
                failInstall("npm could not repair dependencies. Check the log for a corporate proxy, antivirus file lock, or Node.js issue; no administrator permission is required. Close other OpportunityOS windows and choose Install to retry.");
                return;
              }
              verifyOpportunityOS();
            });
          }
        });
      });
    }

    function verifyOpportunityOS() {
      setStep(3, "Verifying OpportunityOS files");
      if (!fso.FileExists(scriptDir + "\\engine_opportunityos.bat")) {
        failInstall("engine_opportunityos.bat was not found in the installer folder.");
        return;
      }
      if (!fso.FileExists(scriptDir + "\\node_modules\\.bin\\vite.cmd")) {
        failInstall("Vite was not found after dependency installation.");
        return;
      }
      logLine("[OK] OpportunityOS files verified.");
      if (!fso.FileExists(scriptDir + "\\OpportunityOS.exe")) {
        logLine("[INFO] OpportunityOS.exe is optional. Shortcuts use the stable launcher instead.");
      }

      setStep(4, "Creating shortcuts");
      if (!fso.FileExists(scriptDir + "\\OPEN_OPPORTUNITYOS.vbs")) {
        failInstall("OPEN_OPPORTUNITYOS.vbs was not found after setup.");
        return;
      }
      createShortcuts();

      // The launcher requires this marker in addition to Vite. It prevents a
      // partial node_modules folder from bypassing this visible setup flow.
      var marker = fso.CreateTextFile(scriptDir + "\\.opportunityos-setup-complete", true);
      marker.WriteLine("OpportunityOS setup completed successfully.");
      marker.Close();

      setStep(5, "Setup complete");
      el("remaining").innerText = "0 steps remaining";
      el("bar").style.width = "100%";
      logLine("[OK] Setup complete. Choose Open app or Close.");
      el("openBtn").disabled = false;
      el("closeBtn").disabled = false;
    }

    function createShortcuts() {
      try {
        var desktopDir = shell.SpecialFolders("Desktop");
        var startMenuDir = shell.SpecialFolders("Programs") + "\\OpportunityOS";
        if (!fso.FolderExists(startMenuDir)) fso.CreateFolder(startMenuDir);

        var iconPath = scriptDir + "\\opportunityos.ico";
        var openTarget = scriptDir + "\\OPEN_OPPORTUNITYOS.vbs";
        var uninstallTarget = scriptDir + "\\DESINSTALAR_OPPORTUNITYOS.vbs";

        // CreateShortcut + Save() always overwrites any shortcut with the
        // same name, so re-running the installer after this folder moves or
        // is reprovisioned self-heals the shortcut's target path instead of
        // leaving a stale one — shortcuts were previously removed entirely
        // to sidestep that exact failure mode on corporate machines.
        var appShortcut = shell.CreateShortcut(desktopDir + "\\OpportunityOS.lnk");
        appShortcut.TargetPath = "wscript.exe";
        appShortcut.Arguments = "\"" + openTarget + "\"";
        appShortcut.WorkingDirectory = scriptDir;
        appShortcut.WindowStyle = 7;
        appShortcut.IconLocation = iconPath + ",0";
        appShortcut.Description = "Open OpportunityOS";
        appShortcut.Save();

        var startShortcut = shell.CreateShortcut(startMenuDir + "\\OpportunityOS.lnk");
        startShortcut.TargetPath = "wscript.exe";
        startShortcut.Arguments = "\"" + openTarget + "\"";
        startShortcut.WorkingDirectory = scriptDir;
        startShortcut.WindowStyle = 7;
        startShortcut.IconLocation = iconPath + ",0";
        startShortcut.Description = "Open OpportunityOS";
        // Windows only honors a shortcut's hotkey while it lives on the
        // Desktop or in the Start Menu; keep it on exactly one shortcut so
        // there's no ambiguity about which target Ctrl+Alt+O launches.
        startShortcut.Hotkey = "CTRL+ALT+O";
        startShortcut.Save();

        var uninstallShortcut = shell.CreateShortcut(startMenuDir + "\\Uninstall OpportunityOS.lnk");
        uninstallShortcut.TargetPath = "wscript.exe";
        uninstallShortcut.Arguments = "\"" + uninstallTarget + "\"";
        uninstallShortcut.WorkingDirectory = scriptDir;
        uninstallShortcut.WindowStyle = 1;
        uninstallShortcut.IconLocation = "%SystemRoot%\\System32\\shell32.dll,-131";
        uninstallShortcut.Description = "Uninstall OpportunityOS";
        uninstallShortcut.Save();

        logLine("[OK] Desktop and Start Menu shortcuts created. Ctrl+Alt+O opens OpportunityOS from anywhere.");
        logLine("[INFO] Pin the Desktop or Start Menu shortcut to your taskbar for a stable icon — pinning the app's live window instead can lose its icon after a restart.");
      } catch (err) {
        logLine("[WARN] Could not create shortcuts: " + err.message + ". OpportunityOS still works via OPEN_OPPORTUNITYOS.vbs in this folder.");
      }
    }

    function openApp() {
      var launcher = scriptDir + "\\OPEN_OPPORTUNITYOS.vbs";
      var closer = scriptDir + "\\CLOSE_OPPORTUNITYOS.bat";
      if (!fso.FileExists(launcher)) {
        failInstall("OPEN_OPPORTUNITYOS.vbs was not found after setup.");
        return;
      }
      if (!fso.FileExists(closer)) {
        failInstall("CLOSE_OPPORTUNITYOS.bat was not found after setup.");
        return;
      }
      el("openBtn").disabled = true;
      el("closeBtn").disabled = true;
      setStep(5, "Closing previous OpportunityOS version");
      el("remaining").innerText = "Freeing local OpportunityOS ports";
      logLine("[INFO] Closing any previous OpportunityOS engine on ports 3000 and 3099. No terminal window is needed.");
      runCommand("call \"" + closer + "\" SILENT", function (closeCode) {
        if (closeCode !== 0) {
          failInstall("The previous OpportunityOS engine could not be stopped. See the log above and retry.");
          return;
        }
        setStep(5, "Starting OpportunityOS");
        el("remaining").innerText = "Checking the local application";
        logLine("[INFO] Starting the new OpportunityOS version in the background.");
        shell.Run("wscript.exe \"" + launcher + "\"", 1, false);
        launchAttempt = 0;
        window.setTimeout(checkAppStarted, 1000);
      });
    }

    function checkAppStarted() {
      var started = false;
      try {
        var request = new ActiveXObject("MSXML2.XMLHTTP");
        request.open("GET", "http://127.0.0.1:3000", false);
        request.send();
        started = request.status >= 200 && request.status < 500;
      } catch (ignore) {}

      if (started) {
        el("status").innerText = "OpportunityOS started successfully";
        el("remaining").innerText = "You may close this setup window";
        el("bar").style.width = "100%";
        logLine("[OK] OpportunityOS is running. The application window should now be open.");
        alert("OpportunityOS started successfully. You can now close this setup window.");
        el("closeBtn").disabled = false;
        return;
      }

      launchAttempt++;
      if (launchAttempt >= 30) {
        failInstall("OpportunityOS did not start within 30 seconds. No terminal is required: use the log above to identify the failed step, then choose Install to retry.");
        return;
      }

      el("remaining").innerText = "Waiting for OpportunityOS to start (" + launchAttempt + "/30)";
      window.setTimeout(checkAppStarted, 1000);
    }
  </script>
</body>
</html>
