<!doctype html>
<html><head><meta http-equiv="x-ua-compatible" content="IE=11"><title>OpportunityOS Uninstaller</title>
<hta:application id="OpportunityOSUninstaller" applicationname="OpportunityOS Uninstaller" border="thin" caption="yes" contextmenu="no" maximizebutton="no" minimizebutton="yes" scroll="no" showintaskbar="yes" singleinstance="yes" sysmenu="yes" />
<style>html,body{width:100%;height:100%;margin:0;overflow:hidden;font-family:"Segoe UI",Arial,sans-serif;color:#1f2933;background:#f3f3f3}.shell{width:700px;height:450px;background:#fff;border:1px solid #c8c8c8;box-sizing:border-box}.header{height:94px;padding:19px 26px;box-sizing:border-box;border-bottom:1px solid #dedede;background:linear-gradient(#fff,#f7f7f7)}h1{margin:0 0 6px;font-size:23px}.subtitle,.remaining{margin:0;color:#5f6b7a;font-size:13px}.content{height:266px;padding:22px 26px;box-sizing:border-box}.row{display:flex;justify-content:space-between;margin-bottom:10px}.status{font-weight:600}.progress{height:17px;border:1px solid #b8b8b8;background:#eee;margin-bottom:17px}.bar{height:100%;width:0;background:#0078d4}.notice{padding:11px 13px;border-left:4px solid #0078d4;background:#f1f7fc;font-size:13px;line-height:1.4;margin-bottom:14px}.log{width:100%;height:78px;box-sizing:border-box;resize:none;border:1px solid #c8c8c8;background:#fbfbfb;font-family:Consolas,monospace;font-size:12px;padding:7px}.footer{height:88px;padding:17px 26px;box-sizing:border-box;border-top:1px solid #dedede;background:#f7f7f7;text-align:right}button{min-width:105px;height:32px;margin-left:8px;border:1px solid #adadad;background:#fff;font-family:"Segoe UI",Arial,sans-serif;font-size:13px}button.primary{border-color:#005a9e;background:#0078d4;color:#fff}button:disabled{color:#999;background:#eee;border-color:#d5d5d5}</style></head>
<body><div class="shell"><div class="header"><h1>Uninstall OpportunityOS</h1><p class="subtitle">Remove OpportunityOS, its dependencies and its shortcuts.</p></div><div class="content"><div class="row"><span id="status" class="status">Ready to uninstall</span><span id="remaining" class="remaining">3 steps remaining</span></div><div class="progress"><div id="bar" class="bar"></div></div><div class="notice"><b>Important:</b><br>The complete OpportunityOS folder, including local OpportunityOS data in it, will be removed. Node.js itself is not removed. After preparation, choose <b>Remove folder now</b>; only the final confirmation message means the folder was actually deleted.</div><textarea id="log" class="log" readonly></textarea></div><div class="footer"><button id="uninstall" class="primary" onclick="startUninstall()">Uninstall</button><button id="close" onclick="closeWindow()">Cancel</button></div></div>
<script language="javascript">
var shell=new ActiveXObject("WScript.Shell"),fso=new ActiveXObject("Scripting.FileSystemObject"),exec,poll,readyToRemove=false,uninstallStartedAt=0;
function e(id){return document.getElementById(id)}function dir(){var configuredRoot=shell.Environment("PROCESS")("OPPORTUNITYOS_ROOT");if(configuredRoot&&fso.FolderExists(configuredRoot))return configuredRoot;var p=decodeURIComponent(location.pathname);p=p.replace(/^\//,"").replace(/\//g,"\\");return fso.GetParentFolderName(p)}var root=dir();window.resizeTo(720,490);window.moveTo((screen.width-720)/2,(screen.height-490)/2);function log(t){e("log").value+=t+"\r\n";e("log").scrollTop=e("log").scrollHeight}function step(n,text){e("status").innerText=text;e("remaining").innerText=Math.max(3-n,0)+" steps remaining";e("bar").style.width=(n*100/3)+"%"}function done(ok){window.clearInterval(poll);e("bar").style.width="100%";e("status").innerText=ok?"Ready for final folder removal":"Cleanup needs attention";e("remaining").innerText=ok?"Choose Remove folder now. A final message will confirm deletion.":"Review the log";e("close").innerText=ok?"Remove folder now":"Close";readyToRemove=ok;e("close").disabled=false}
function removeProjectFolder(){var temp=fso.GetSpecialFolder(2),path=temp+"\\OpportunityOS-remove-"+fso.GetTempName()+".ps1",file=fso.CreateTextFile(path,true),escaped=root.replace(/'/g,"''");file.WriteLine("$target = '"+escaped+"'");file.WriteLine("$ports = @(3000,3099)");file.WriteLine("Get-NetTCPConnection -State Listen -ErrorAction SilentlyContinue | Where-Object { $ports -contains $_.LocalPort } | Select-Object -ExpandProperty OwningProcess -Unique | ForEach-Object { Stop-Process -Id $_ -Force -ErrorAction SilentlyContinue }");file.WriteLine("Start-Sleep -Seconds 2");file.WriteLine("for ($i = 0; $i -lt 60; $i++) { try { Remove-Item -LiteralPath $target -Recurse -Force -ErrorAction Stop; if (-not (Test-Path -LiteralPath $target)) { break } } catch {} ; Start-Sleep -Seconds 1 }");file.WriteLine("$popup = New-Object -ComObject WScript.Shell");file.WriteLine("if (-not (Test-Path -LiteralPath $target)) { $popup.Popup('OpportunityOS folder was completely removed. Node.js was not changed.', 0, 'OpportunityOS uninstalled', 64) } else { $popup.Popup('OpportunityOS could not remove every file after 60 seconds. Close any Explorer, terminal, VS Code or antivirus window using this folder, then use Remove folder now again: ' + $target, 0, 'OpportunityOS cleanup needs attention', 48) }");file.WriteLine("Remove-Item -LiteralPath $PSCommandPath -Force -ErrorAction SilentlyContinue");file.Close();shell.Run("powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File \""+path+"\"",0,false)}
function closeWindow(){if(!readyToRemove){window.close();return}e("close").disabled=true;e("status").innerText="Removing complete OpportunityOS folder";e("remaining").innerText="Please wait for the final confirmation message";log("[INFO] Closing this window and deleting the complete folder now.");removeProjectFolder();window.setTimeout(function(){window.close()},300)}
function startUninstall(){
  if(!window.confirm("Remove the complete OpportunityOS folder, including local OpportunityOS data stored in it? Node.js itself will remain installed.")) return;
  e("uninstall").disabled=true;
  e("close").disabled=true;
  step(1,"Closing OpportunityOS processes");
  var engine=root+"\\DESINSTALAR_OPPORTUNITYOS.bat";
  var desktop=shell.SpecialFolders("Desktop");
  var menu=shell.SpecialFolders("Programs")+"\\OpportunityOS";
  if(!fso.FileExists(engine)){
    log("[ERROR] The cleanup engine is missing: "+engine);
    done(false);
    return;
  }

  // WScript.Shell.Exec exposes the process status directly. Do not use a
  // second temporary "done" file: some Windows shells never created it,
  // leaving the UI stuck even though the batch process had already finished.
  var cleanupProcess;
  try {
    cleanupProcess = shell.Exec("cmd.exe /d /c call \"" + engine + "\" \"" + desktop + "\" \"" + menu + "\"");
  } catch (err) {
    log("[ERROR] Could not start cleanup: " + err.message);
    done(false);
    return;
  }
  uninstallStartedAt = new Date().getTime();

  poll = window.setInterval(function(){
    if (cleanupProcess.Status !== 0) {
      window.clearInterval(poll);
      try {
        var output = cleanupProcess.StdOut.ReadAll();
        var lines = output.split(/\r?\n/);
        for (var i = 0; i < lines.length; i++) if (lines[i]) log(lines[i]);
      } catch (e) {}
      step(3,"Final checks complete");
      done(cleanupProcess.ExitCode === 0);
      if(cleanupProcess.ExitCode === 0) log("[INFO] Preparation is complete. Select 'Remove folder now' to delete the project folder.");
    } else if ((new Date().getTime() - uninstallStartedAt) > 15000) {
      window.clearInterval(poll);
      log("[ERROR] Cleanup did not return within 15 seconds. Close this window and try again after closing any remaining OpportunityOS window.");
      e("status").innerText="Cleanup needs attention";
      e("remaining").innerText="Review the log, then close this window";
      e("close").innerText="Close";
      e("close").disabled=false;
    } else {
      step(2,"Removing OpportunityOS files");
    }
  }, 250);
}
</script></body></html>
